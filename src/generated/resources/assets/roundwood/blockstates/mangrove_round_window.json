{
  "multipart": [
    {
      "apply": {
        "model": "roundwood:block/round_window"
      },
      "when": {
        "axis": "x",
        "north": "false",
        "position": "center",
        "south": "false",
        "trimmed": "false"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_arms_north"
      },
      "when": {
        "axis": "x",
        "north": "true",
        "position": "center",
        "south": "false",
        "trimmed": "false"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_arms_south"
      },
      "when": {
        "axis": "x",
        "north": "false",
        "position": "center",
        "south": "true",
        "trimmed": "false"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_arms_both"
      },
      "when": {
        "axis": "x",
        "north": "true",
        "position": "center",
        "south": "true",
        "trimmed": "false"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_trimmed"
      },
      "when": {
        "axis": "x",
        "north": "false",
        "position": "center",
        "south": "false",
        "trimmed": "true"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_trimmed_arms_north"
      },
      "when": {
        "axis": "x",
        "north": "true",
        "position": "center",
        "south": "false",
        "trimmed": "true"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_trimmed_arms_south"
      },
      "when": {
        "axis": "x",
        "north": "false",
        "position": "center",
        "south": "true",
        "trimmed": "true"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_trimmed_arms_both"
      },
      "when": {
        "axis": "x",
        "north": "true",
        "position": "center",
        "south": "true",
        "trimmed": "true"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window",
        "y": 90
      },
      "when": {
        "axis": "z",
        "east": "false",
        "position": "center",
        "trimmed": "false",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_arms_north",
        "y": 90
      },
      "when": {
        "axis": "z",
        "east": "true",
        "position": "center",
        "trimmed": "false",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_arms_south",
        "y": 90
      },
      "when": {
        "axis": "z",
        "east": "false",
        "position": "center",
        "trimmed": "false",
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_arms_both",
        "y": 90
      },
      "when": {
        "axis": "z",
        "east": "true",
        "position": "center",
        "trimmed": "false",
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_trimmed",
        "y": 90
      },
      "when": {
        "axis": "z",
        "east": "false",
        "position": "center",
        "trimmed": "true",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_trimmed_arms_north",
        "y": 90
      },
      "when": {
        "axis": "z",
        "east": "true",
        "position": "center",
        "trimmed": "true",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_trimmed_arms_south",
        "y": 90
      },
      "when": {
        "axis": "z",
        "east": "false",
        "position": "center",
        "trimmed": "true",
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_trimmed_arms_both",
        "y": 90
      },
      "when": {
        "axis": "z",
        "east": "true",
        "position": "center",
        "trimmed": "true",
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_back"
      },
      "when": {
        "position": "north",
        "trimmed": "false"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_back_trimmed"
      },
      "when": {
        "position": "north",
        "trimmed": "true"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_back",
        "y": 90
      },
      "when": {
        "position": "east",
        "trimmed": "false"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_back_trimmed",
        "y": 90
      },
      "when": {
        "position": "east",
        "trimmed": "true"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_back",
        "y": 180
      },
      "when": {
        "position": "south",
        "trimmed": "false"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_back_trimmed",
        "y": 180
      },
      "when": {
        "position": "south",
        "trimmed": "true"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_back",
        "y": 270
      },
      "when": {
        "position": "west",
        "trimmed": "false"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_back_trimmed",
        "y": 270
      },
      "when": {
        "position": "west",
        "trimmed": "true"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_down_ceiling"
      },
      "when": {
        "position": "up",
        "trimmed": "false"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_down_ceiling_trimmed"
      },
      "when": {
        "position": "up",
        "trimmed": "true"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_up_floor"
      },
      "when": {
        "position": "down",
        "trimmed": "false"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_up_floor_trimmed"
      },
      "when": {
        "position": "down",
        "trimmed": "true"
      }
    }
  ]
}