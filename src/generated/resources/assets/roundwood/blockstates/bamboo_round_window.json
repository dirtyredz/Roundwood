{
  "multipart": [
    {
      "apply": {
        "model": "roundwood:block/round_window"
      },
      "when": {
        "axis": "x",
        "position": "center"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window",
        "y": 90
      },
      "when": {
        "axis": "z",
        "position": "center"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_back"
      },
      "when": {
        "position": "north"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_back",
        "y": 90
      },
      "when": {
        "position": "east"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_back",
        "y": 180
      },
      "when": {
        "position": "south"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_back",
        "y": 270
      },
      "when": {
        "position": "west"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_down_ceiling"
      },
      "when": {
        "position": "up"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_up_floor"
      },
      "when": {
        "position": "down"
      }
    }
  ]
}