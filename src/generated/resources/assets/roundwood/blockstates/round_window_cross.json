{
  "multipart": [
    {
      "apply": {
        "model": "roundwood:block/round_window_cross"
      },
      "when": {
        "axis": "x",
        "north": "false",
        "position": "center",
        "south": "false"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_cross_arms_north"
      },
      "when": {
        "axis": "x",
        "north": "true",
        "position": "center",
        "south": "false"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_cross_arms_south"
      },
      "when": {
        "axis": "x",
        "north": "false",
        "position": "center",
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_cross_arms_both"
      },
      "when": {
        "axis": "x",
        "north": "true",
        "position": "center",
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_cross",
        "y": 90
      },
      "when": {
        "axis": "z",
        "east": "false",
        "position": "center",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_cross_arms_north",
        "y": 90
      },
      "when": {
        "axis": "z",
        "east": "true",
        "position": "center",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_cross_arms_south",
        "y": 90
      },
      "when": {
        "axis": "z",
        "east": "false",
        "position": "center",
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_cross_arms_both",
        "y": 90
      },
      "when": {
        "axis": "z",
        "east": "true",
        "position": "center",
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_cross_back"
      },
      "when": {
        "position": "north"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_cross_back",
        "y": 90
      },
      "when": {
        "position": "east"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_cross_back",
        "y": 180
      },
      "when": {
        "position": "south"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_cross_back",
        "y": 270
      },
      "when": {
        "position": "west"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_cross_down_ceiling"
      },
      "when": {
        "position": "up"
      }
    },
    {
      "apply": {
        "model": "roundwood:block/round_window_cross_up_floor"
      },
      "when": {
        "position": "down"
      }
    }
  ]
}